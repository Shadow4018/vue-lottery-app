# Базова адреса REST API (DummyJSON). Скопіюйте цей файл у .env: cp .env.example .env
VITE_API_URL=https://dummyjson.com
# Назва застосунку (заголовок вкладки браузера)
VITE_APP_TITLE=Vue Lottery
# Час життя accessToken у хвилинах (передається в /auth/login та /auth/refresh)
VITE_ACCESS_TOKEN_TTL_MINUTES=30
